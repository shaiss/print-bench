# Boolean fit checks (gate.sh). empty = zero facets; interferes = mandatory
# negative control proving the check can fail.
mates           empty
mates-ctrl      interferes
axle-fit        empty
axle-fit-ctrl   interferes
joint-fit       empty
joint-fit-ctrl  interferes
# Assembled back disc: thin annulus through the closed floor must be empty
# (N3 — no angular through-gap between pies). Ctrl omits one segment.
back-closed      empty
back-closed-ctrl interferes
