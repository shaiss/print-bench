{
  "schema": "stylelift/style@1",
  "name": "orrery",
  "title": "Orrery",
  "summary": "Twisted-blade vortex cages carrying captive floating rings on 50-degree conical seats — kinetic, dual-material, supportless by construction",
  "provenance": {
    "reference": [
      {
        "file": "nuggs-orrery-kinetic.stl",
        "sha256": "84385a5b72a3705ea2704bd8af9082ae75ce1e0530ba72d3a261fb6f207ff8bd",
        "source": "first-party: designs/nuggs-orrery in this repository (part=kinetic render)",
        "license": "CC BY-SA 4.0 (this repository's own license)"
      }
    ],
    "lifted_by": "stylelift",
    "primary": "nuggs-orrery-kinetic.stl"
  },
  "tokens": {
    "fn": 128,
    "ramp_deg": 50,
    "blade_th": 2.4,
    "blade_twist_rate": 0.51,
    "ring_h": 3.6,
    "seat_gap": 0.1
  },
  "asserted": {
    "kinetic": "every piece carries at least one captive free-moving element, trapped by geometry (its hole is smaller than the cage it circles) — printed in place, never assembled",
    "dual_material": "the moving elements print in a second, non-welding material (PETG body + PLA accents); the anti-bond interface that supports them during the print is the bearing they run on afterwards",
    "supportless": "every downward face sits at ramp_deg from horizontal, is a designed micro-bridge, or rests on the other material; the style never generates slicer supports",
    "palette": "dark, low-sheen body; saturated high-contrast accent rings — the second material is meant to be seen moving"
  },
  "rules": [
    {
      "id": "curve-smoothness",
      "metric": "edges.rounding.implied_fn",
      "op": "min",
      "value": 89,
      "severity": "required",
      "when": {
        "metric": "edges.rounding.dominant_r_mm",
        "op": "min",
        "value": 10
      },
      "why": "large visible curves in this family are drawn at about $fn=128; visibly faceted barrels and rings break the family look. Scoped to parts whose dominant rounding is >= 10 mm: on a small accent piece the estimator reads the deliberately faceted ring cross-section as a coarse sub-3 mm circle (measured on the reference's own orbit STL), and that is section grammar, not a curve"
    },
    {
      "id": "soft-edges",
      "metric": "edges.softness",
      "op": "min",
      "value": 0.49,
      "severity": "advisory",
      "why": "this is a soft family: most of its edge length curves rather than turning a corner (falls as a part grows, so advisory)"
    },
    {
      "id": "grammar-sharp",
      "metric": "edges.grammar.sharp_share",
      "op": "min",
      "value": 0.4,
      "severity": "advisory",
      "why": "the blades are knife-clean: the reference treats 67% of its shaped edge length as sharp, and softening the blades reads as a different family"
    },
    {
      "id": "ramp-grammar",
      "metric": "orientation.sloped_share",
      "op": "min",
      "value": 0.15,
      "severity": "required",
      "why": "the family's one chamfer is the ramp_deg cone: lead-ins, groove roofs and ring seats are all the same 50-degree cut, which is what makes the style supportless. Required because it is the one signature every family part carries (reference body 0.36, its orbit rings 0.24, the swatch 0.36)"
    },
    {
      "id": "massing",
      "metric": "massing.bbox_fill",
      "op": "max",
      "value": 0.3,
      "severity": "advisory",
      "why": "the form is carved away, never blocky — a vortex cage fills well under a third of its bounding box (the reference fills 8%, the swatch 15%)"
    }
  ],
